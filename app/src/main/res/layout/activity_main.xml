<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:elevation="4dp"
        android:theme="@style/ThemeOverlay.AppCompat.ActionBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

    <TableLayout
        android:id="@+id/boardTable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#000"
        android:orientation="vertical"
        android:stretchColumns="0,1,2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <TableRow style="@style/rowLayout">
            <TextView
                android:id="@+id/status"
                style="@style/textLayout"
                android:layout_column="0"
                android:layout_weight="0.35" />
        </TableRow>

        <TableRow
            style="@style/rowLayout"
            android:visibility="visible">
            <TextView
                android:id="@+id/land6"
                style="@style/textLayout"
                android:layout_column="0"
                android:layout_weight="0.35"
                android:tag="6" />
            <TextView
                android:id="@+id/road1"
                style="@style/textLayout"
                android:layout_column="1"
                android:layout_weight="0.3" />
            <TextView
                android:id="@+id/land1"
                style="@style/textLayout"
                android:layout_column="2"
                android:layout_weight="0.35"
                android:tag="1" />
        </TableRow>

        <TableRow
            style="@style/rowLayout"
            android:visibility="visible">
            <TextView
                android:id="@+id/road6"
                style="@style/textLayout"
                android:layout_column="0"
                android:layout_weight="0.35" />
            <TextView
                android:id="@+id/publicQuest1"
                style="@style/textLayout"
                android:layout_column="1"
                android:layout_weight="0.3" />
            <TextView
                android:id="@+id/road2"
                style="@style/textLayout"
                android:layout_column="2"
                android:layout_weight="0.35" />
        </TableRow>

        <TableRow
            style="@style/rowLayout"
            android:visibility="visible">
            <TextView
                android:id="@+id/land5"
                style="@style/textLayout"
                android:layout_column="0"
                android:layout_weight="0.35"
                android:tag="5" />
            <TextView
                android:id="@+id/road7"
                style="@style/textLayout"
                android:layout_column="1"
                android:layout_weight="0.3" />
            <TextView
                android:id="@+id/land2"
                style="@style/textLayout"
                android:layout_column="2"
                android:layout_weight="0.35"
                android:tag="2" />
        </TableRow>

        <TableRow
            style="@style/rowLayout"
            android:visibility="visible">
            <TextView
                android:id="@+id/road5"
                style="@style/textLayout"
                android:layout_column="0"
                android:layout_weight="0.35" />
            <TextView
                android:id="@+id/publicQuest2"
                style="@style/textLayout"
                android:layout_column="1"
                android:layout_weight="0.3" />
            <TextView
                android:id="@+id/road3"
                style="@style/textLayout"
                android:layout_column="2"
                android:layout_weight="0.35" />
        </TableRow>

        <TableRow
            style="@style/rowLayout"
            android:visibility="visible">
            <TextView
                android:id="@+id/land4"
                style="@style/textLayout"
                android:layout_column="0"
                android:layout_weight="0.35"
                android:tag="4" />
            <TextView
                android:id="@+id/road4"
                style="@style/textLayout"
                android:layout_column="1"
                android:layout_weight="0.3" />
            <TextView
                android:id="@+id/land3"
                style="@style/textLayout"
                android:layout_column="2"
                android:layout_weight="0.35"
                android:tag="3" />
        </TableRow>

        <TableRow android:weightSum="6">
            <Button
                android:id="@+id/buttonMove"
                style="@style/buttonLayout"
                android:layout_column="0"
                android:layout_weight="1"
                android:text="Move"
                android:textSize="8sp" />
            <Button
                android:id="@+id/buttonTower"
                style="@style/buttonLayout"
                android:layout_column="1"
                android:layout_weight="1"
                android:text="Tower Visit"
                android:textSize="8sp" />
            <Button
                android:id="@+id/buttonFlyingCarpet"
                style="@style/buttonLayout"
                android:layout_column="2"
                android:layout_weight="1"
                android:text="Flying Carpet"
                android:textSize="8sp" />
            <Button
                android:id="@+id/buttonStoreCards"
                style="@style/buttonLayout"
                android:layout_column="3"
                android:layout_weight="1"
                android:text="Store Cards"
                android:textSize="8sp" />
            <Button
                android:id="@+id/buttonStoreQuestCards"
                style="@style/buttonLayout"
                android:layout_column="4"
                android:layout_weight="1"
                android:text="Quest Cards"
                android:textSize="8sp" />
            <Button
                android:id="@+id/buttonDone"
                style="@style/buttonLayout"
                android:layout_column="5"
                android:layout_weight="1"
                android:text="Done"
                android:textSize="8sp" />
        </TableRow>

        <TableRow style="@style/rowLayout">
            <TextView
                android:id="@+id/gems"
                style="@style/textLayout"
                android:layout_column="0"
                android:layout_weight="0.35" />
            <TextView
                android:id="@+id/vps"
                style="@style/textLayout"
                android:layout_column="1"
                android:layout_weight="0.35" />
            <TextView
                android:id="@+id/deck"
                style="@style/textLayout"
                android:layout_column="2"
                android:layout_weight="0.35" />
            <TextView
                android:id="@+id/discard"
                style="@style/textLayout"
                android:layout_column="3"
                android:layout_weight="0.35" />
        </TableRow>

        <TableRow
            android:layout_margin="10dp"
            android:visibility="visible">
            <TextView
                android:id="@+id/hand1"
                style="@style/textLayout"
                android:layout_column="0"
                android:layout_weight="0.4" />
            <TextView
                android:id="@+id/hand2"
                style="@style/textLayout"
                android:layout_column="1"
                android:layout_weight="0.4" />
            <TextView
                android:id="@+id/hand3"
                style="@style/textLayout"
                android:layout_column="2"
                android:layout_weight="0.4" />
            <TextView
                android:id="@+id/hand4"
                style="@style/textLayout"
                android:layout_column="3"
                android:layout_weight="0.4" />
            <TextView
                android:id="@+id/hand5"
                style="@style/textLayout"
                android:layout_column="4"
                android:layout_weight="0.4" />
        </TableRow>

        <TableRow
            android:layout_margin="5dp"
            android:visibility="visible">
            <TextView
                android:id="@+id/hand6"
                style="@style/textLayout"
                android:layout_column="0"
                android:layout_weight="0.4" />
            <TextView
                android:id="@+id/hand7"
                style="@style/textLayout"
                android:layout_column="1"
                android:layout_weight="0.4" />
            <TextView
                android:id="@+id/hand8"
                style="@style/textLayout"
                android:layout_column="2"
                android:layout_weight="0.4" />
            <TextView
                android:id="@+id/hand9"
                style="@style/textLayout"
                android:layout_column="3"
                android:layout_weight="0.4" />
            <TextView
                android:id="@+id/hand10"
                style="@style/textLayout"
                android:layout_column="4"
                android:layout_weight="0.4" />
        </TableRow>

        <TableRow android:layout_margin="5dp">
            <TextView
                android:id="@+id/stored0"
                style="@style/textLayout"
                android:layout_column="1"
                android:layout_weight="0.4" />
            <TextView
                android:id="@+id/stored1"
                style="@style/textLayout"
                android:layout_column="2"
                android:layout_weight="0.4" />
            <TextView
                android:id="@+id/stored2"
                style="@style/textLayout"
                android:layout_column="3"
                android:layout_weight="0.4" />
            <TextView
                android:id="@+id/stored3"
                style="@style/textLayout"
                android:layout_column="4"
                android:layout_weight="0.4" />
            <TextView
                android:id="@+id/stored4"
                style="@style/textLayout"
                android:layout_column="5"
                android:layout_weight="0.4" />
        </TableRow>

        <TableRow
            android:layout_margin="2dp"
            android:visibility="visible">
            <TextView
                android:id="@+id/quest0"
                style="@style/textLayout"
                android:layout_column="0"
                android:layout_weight="0.4" />
            <TextView
                android:id="@+id/quest00"
                style="@style/textLayout"
                android:layout_column="1"
                android:layout_weight="0.4" />
            <TextView
                android:id="@+id/quest01"
                style="@style/textLayout"
                android:layout_column="2"
                android:layout_weight="0.4" />
            <TextView
                android:id="@+id/quest02"
                style="@style/textLayout"
                android:layout_column="3"
                android:layout_weight="0.4" />
            <TextView
                android:id="@+id/quest03"
                style="@style/textLayout"
                android:layout_column="4"
                android:layout_weight="0.4" />
            <TextView
                android:id="@+id/quest04"
                style="@style/textLayout"
                android:layout_column="5"
                android:layout_weight="0.4" />
        </TableRow>

        <TableRow
            android:layout_margin="2dp"
            android:visibility="visible">
            <TextView
                android:id="@+id/quest1"
                style="@style/textLayout"
                android:layout_column="0"
                android:layout_weight="0.4"
                android:text="EmptyQuest:" />
            <TextView
                android:id="@+id/quest10"
                style="@style/textLayout"
                android:layout_column="1"
                android:layout_weight="0.4" />
            <TextView
                android:id="@+id/quest11"
                style="@style/textLayout"
                android:layout_column="2"
                android:layout_weight="0.4" />
            <TextView
                android:id="@+id/quest12"
                style="@style/textLayout"
                android:layout_column="3"
                android:layout_weight="0.4" />
            <TextView
                android:id="@+id/quest13"
                style="@style/textLayout"
                android:layout_column="4"
                android:layout_weight="0.4" />
            <TextView
                android:id="@+id/quest14"
                style="@style/textLayout"
                android:layout_column="5"
                android:layout_weight="0.4" />
        </TableRow>
    </TableLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHand"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
